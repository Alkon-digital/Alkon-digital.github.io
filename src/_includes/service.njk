---
layout: base.njk
---
<section class="phero{% if not cover %} phero--plain{% endif %}"{% if cover %} style="--cover:url('{{ cover }}')"{% endif %}>
  <div class="wrap phero__in">
    <ol class="crumbs"><li><a href="/">Главная</a></li><li><a href="/uslugi/">Услуги</a></li><li>{{ h1 | default(title) }}</li></ol>
    <span class="eyebrow">Услуга</span>
    <h1>{{ h1 | default(title) }}</h1>
    <p class="section__lead">{{ lead }}</p>

    <div class="phero__cta">
      <a class="btn" href="/kontakty/">Обсудить задачу <span class="btn__dot">→</span></a>
      <a class="btn btn--ghost" href="/tseny/">Все цены</a>
    </div>

    <dl class="phero__spec">
      {%- if forWhom %}
      <div class="phero__spec-i"><dt class="phero__spec-k">Кому</dt><dd class="phero__spec-v">{{ forWhom }}</dd></div>
      {%- endif %}
      {%- if result %}
      <div class="phero__spec-i"><dt class="phero__spec-k">Что на выходе</dt><dd class="phero__spec-v">{{ result }}</dd></div>
      {%- endif %}
      {%- if term %}
      <div class="phero__spec-i"><dt class="phero__spec-k">Срок</dt><dd class="phero__spec-v">{{ term }}</dd></div>
      {%- endif %}
      {%- if price %}
      <div class="phero__spec-i"><dt class="phero__spec-k">Стоимость</dt><dd class="phero__spec-v phero__spec-v--price">{{ price | safe }}<span>{{ priceUnit | safe }}</span></dd></div>
      {%- endif %}
    </dl>
    {%- if priceNote %}<p class="phero__note">{{ priceNote }}</p>{% endif %}
  </div>
</section>

{%- if includes %}
<section class="section section--rule wrap">
  <h2>Что входит</h2>
  <ul class="grid">
    {%- for item in includes %}
    <li class="grid__item">
      <h3>{{ item.name }}</h3>
      <p>{{ item.text }}</p>
    </li>
    {%- endfor %}
  </ul>
</section>
{%- endif %}

<section class="section section--rule wrap post__body">
  {{ content | safe }}
</section>

{%- if faq %}
<section class="section section--rule wrap">
  <h2>Частые вопросы</h2>
  <div class="faq">
    {%- for item in faq %}
    <details class="faq__item" name="faq">
      <summary class="faq__q">{{ item.q }}<span class="faq__sign" aria-hidden="true"></span></summary>
      <div class="faq__a"><p>{{ item.a }}</p></div>
    </details>
    {%- endfor %}
  </div>
</section>
{%- endif %}

{%- if related %}
<section class="section section--rule wrap">
  <h2>С чем это обычно идёт вместе</h2>
  <ul class="rows">
    {%- for item in related %}
    <li><a class="row" href="{{ item.url }}"><span class="row__name">{{ item.name }}</span><p class="row__text">{{ item.text }}</p><span class="row__go">→</span></a></li>
    {%- endfor %}
  </ul>
</section>
{%- endif %}

<section class="section section--rule wrap">
  <div class="cta">
    <div>
      <h2>{{ ctaTitle | default("Начнём с разбора") }}</h2>
      <p>{{ ctaText | default("Посмотрим, что происходит сейчас, и покажем, где теряются пациенты. Бесплатно и ни к чему не обязывает.") }}</p>
    </div>
    <a class="btn" href="/kontakty/">Оставить заявку <span class="btn__dot">→</span></a>
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Главная", "item": "{{ site.url }}/" },
    { "@type": "ListItem", "position": 2, "name": "Услуги", "item": "{{ site.url }}/uslugi/" },
    { "@type": "ListItem", "position": 3, "name": {{ (h1 | default(title)) | dump | safe }}, "item": "{{ page.url | absolute(site.url) }}" }
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": {{ (h1 | default(title)) | dump | safe }},
  "description": {{ description | dump | safe }},
  "serviceType": {{ (h1 | default(title)) | dump | safe }},
  "areaServed": { "@type": "Country", "name": "Россия" },
  "provider": { "@type": "Organization", "name": {{ site.name | dump | safe }}, "url": "{{ site.url }}" },
  "url": "{{ page.url | absolute(site.url) }}"
}
</script>
{%- if faq %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for item in faq %}
    { "@type": "Question", "name": {{ item.q | dump | safe }}, "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | dump | safe }} } }{% if not loop.last %},{% endif %}
    {%- endfor %}
  ]
}
</script>
{%- endif %}
