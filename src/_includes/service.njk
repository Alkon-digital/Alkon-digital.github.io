---
layout: base.njk
---
<section class="svc__hero"{% if cover %} style="--cover:url('{{ cover }}')"{% endif %}>
  <div class="wrap svc__hero-in">
    <span class="eyebrow">Услуга</span>
    <h1>{{ h1 | default(title) }}</h1>
    <p class="section__lead">{{ lead }}</p>

    <div class="svc__cta">
      <a class="btn" href="/kontakty/">Обсудить задачу <span class="btn__dot">→</span></a>
      <a class="btn btn--ghost" href="/tseny/">Все цены</a>
    </div>

    <dl class="svc__spec">
      {%- if forWhom %}
      <div class="svc__spec-i"><dt class="svc__spec-k">Кому</dt><dd class="svc__spec-v">{{ forWhom }}</dd></div>
      {%- endif %}
      {%- if result %}
      <div class="svc__spec-i"><dt class="svc__spec-k">Что на выходе</dt><dd class="svc__spec-v">{{ result }}</dd></div>
      {%- endif %}
      {%- if term %}
      <div class="svc__spec-i"><dt class="svc__spec-k">Срок</dt><dd class="svc__spec-v">{{ term }}</dd></div>
      {%- endif %}
      <div class="svc__spec-i"><dt class="svc__spec-k">Стоимость</dt><dd class="svc__spec-v svc__spec-v--price">{{ price }}<span>{{ priceUnit }}</span></dd></div>
    </dl>
    {%- if priceNote %}<p class="svc__note">{{ priceNote }}</p>{% endif %}
  </div>
</section>

{%- if includes %}
<section class="section section--rule wrap">
  <h2>Что входит</h2>
  <ul class="grid">
    {%- for item in includes %}
    <li class="grid__item">
      <h3>{{ item.name }}</h3>
      <p>{{ item.text }}</p>
    </li>
    {%- endfor %}
  </ul>
</section>
{%- endif %}

<section class="section section--rule wrap post__body">
  {{ content | safe }}
</section>

{%- if faq %}
<section class="section section--rule wrap">
  <h2>Частые вопросы</h2>
  <dl class="faq">
    {%- for item in faq %}
    <div class="faq__item">
      <dt class="faq__q">{{ item.q }}</dt>
      <dd class="faq__a">{{ item.a }}</dd>
    </div>
    {%- endfor %}
  </dl>
</section>
{%- endif %}

{%- if related %}
<section class="section section--rule wrap">
  <h2>С чем это обычно идёт вместе</h2>
  <ul class="rows">
    {%- for item in related %}
    <li><a class="row" href="{{ item.url }}"><span class="row__name">{{ item.name }}</span><p class="row__text">{{ item.text }}</p><span class="row__go">→</span></a></li>
    {%- endfor %}
  </ul>
</section>
{%- endif %}

<section class="section section--rule wrap">
  <div class="cta">
    <div>
      <h2>{{ ctaTitle | default("Начнём с разбора") }}</h2>
      <p>{{ ctaText | default("Посмотрим, что происходит сейчас, и покажем, где теряются пациенты. Бесплатно и ни к чему не обязывает.") }}</p>
    </div>
    <a class="btn" href="/kontakty/">Оставить заявку <span class="btn__dot">→</span></a>
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": {{ (h1 | default(title)) | dump | safe }},
  "description": {{ description | dump | safe }},
  "serviceType": {{ (h1 | default(title)) | dump | safe }},
  "areaServed": { "@type": "Country", "name": "Россия" },
  "provider": { "@type": "Organization", "name": {{ site.name | dump | safe }}, "url": "{{ site.url }}" },
  "url": "{{ page.url | absolute(site.url) }}"
}
</script>
{%- if faq %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for item in faq %}
    { "@type": "Question", "name": {{ item.q | dump | safe }}, "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | dump | safe }} } }{% if not loop.last %},{% endif %}
    {%- endfor %}
  ]
}
</script>
{%- endif %}
